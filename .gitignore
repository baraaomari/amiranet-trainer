# ── مفاتيح المشروع ──
# config.js يحمل مفاتيح Supabase الخاصة بكل نشر.
# انسخ web/config.example.js إليه واملأه محلياً.
web/config.js
keepalive-url.txt

# ── محتوى المصدر ──
# ملفات المستخدم الخام (كتب، PDF) — قد تكون محميّة بحقوق نشر.
content/

# ── مخرجات البناء ──
# تُولَّد كلها بأمر: python update.py
app.html
web/index.html
web/robots.txt
web/sitemap.xml
web/manifest.webmanifest
web/icon-*.png
*.zip
data/vocab.json
data/exams.json

# ── Claude Code ──
# الـagents الرسمية تُنشر مع المشروع؛ باقي إعدادات .claude محلية.
.claude/*
!.claude/agents/
# مسودات الأسئلة قبل التدقيق والدمج في data/
drafts/

# ── نظام التشغيل والمحررات ──
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
__pycache__/
*.pyc

# ── ملفات PDF أينما وُضعت ──
# مصادر خام قد تكون محميّة بحقوق نشر — لا تدخل المستودع العام.
*.pdf
